{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rhythm",
  "version": "0.1.0",
  "identifier": "app.rhythm.quietroom",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [{
      "label": "main",
      "title": "Rhythm",
      "width": 1000,
      "height": 760,
      "minWidth": 400,
      "minHeight": 520,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' asset: data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Productivity",
    "shortDescription": "A quiet room for attention and rest.",
    "icon": ["icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "SimpChinese", "TradChinese"],
        "displayLanguageSelector": true
      }
    }
  }
}
